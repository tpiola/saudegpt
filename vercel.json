{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "regions": ["gru1"],
  "routes": [
    { "src": "/maintenance.html", "dest": "/maintenance.html" },
    { "src": "/_next/static/(.*)", "dest": "/_next/static/$1" },
    { "src": "/favicon.ico", "dest": "/favicon.ico" },
    { "src": "/(.*)", "dest": "/maintenance.html" }
  ]
}
