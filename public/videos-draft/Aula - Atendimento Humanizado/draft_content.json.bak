width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"d1b6a1ee-d19d-480b-a024-9424cedb510a","type":"text","content":"{\"styles\":[{\"range\":[0,146],\"size\":42,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"Quando um cliente entra na farmácia, ele não busca apenas um medicamento.\"}","alignment":1,"font_size":42,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"a4032033-291c-4ad3-98e3-ae3cddf3dd1a","type":"text","content":"{\"styles\":[{\"range\":[0,78],\"size\":42,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"Ele busca cuidado, atenção e segurança.\"}","alignment":1,"font_size":42,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"8ac692a7-afd0-43c0-859b-dcc58cfd177e","type":"text","content":"{\"styles\":[{\"range\":[0,100],\"size\":42,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"Seu papel como atendente vai muito além de vender.\"}","alignment":1,"font_size":42,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"0744fc5e-85c7-4398-8001-9789e0154133","type":"text","content":"{\"styles\":[{\"range\":[0,124],\"size\":42,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"Você é o primeiro ponto de contato entre o paciente e a saúde.\"}","alignment":1,"font_size":42,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1}],"stickers":[],"video_effects":[],"transitions":[],"masks":[],"chromas":[],"audio_fades":[],"audio_effects":[],"canvases":[{"id":"6feb14c1-f5a6-4aa3-bd1a-aba5a3616282","type":"canvas_color","album_image":"","blur":0,"color":"","image":"","image_id":"","image_name":"","source_platform":0,"team_id":""}],"speeds":[{"id":"0632a131-41b4-4ca2-82dc-be074d8677e7","type":"speed","speed":1,"mode":0,"curve_speed":null},{"id":"3cc99f53-81c6-4706-abaf-9bd2e26d7ce0","type":"speed","speed":1,"mode":0,"curve_speed":null},{"id":"1f086d29-1614-4051-ba33-8a4687f15fe0","type":"speed","speed":1,"mode":0,"curve_speed":null},{"id":"40b5db7d-c6a9-47aa-a496-b82c3e63bf7c","type":"speed","speed":1,"mode":0,"curve_speed":null},{"id":"7c540048-2b5e-4ada-89c7-a017c907184a","type":"speed","speed":1,"mode":0,"curve_speed":null},{"id":"2e19dc03-23bf-40ca-a5b8-7b461a6de89e","type":"speed","speed":1,"mode":0,"curve_speed":null},{"id":"8dc9bb18-c407-4fad-8088-b3d36066eebc","type":"speed","speed":1,"mode":0,"curve_speed":null}],"sound_channel_mappings":[{"id":"8f9536a0-79f9-4755-87d4-5653c4a00900","type":"none","audio_channel_mapping":0,"is_config_open":false},{"id":"edbabec8-22ab-4207-bfe3-919ebd521229","type":"none","audio_channel_mapping":0,"is_config_open":false},{"id":"fa261d43-1973-4cc9-89a8-8cd618638bf3","type":"none","audio_channel_mapping":0,"is_config_open":false},{"id":"06570b11-2a44-44c5-b6c0-ba6394a27c78","type":"none","audio_channel_mapping":0,"is_config_open":false},{"id":"0cd7d423-aa9d-49d1-a830-8cd4bf9cba8e","type":"none","audio_channel_mapping":0,"is_config_open":false},{"id":"35f9e250-0617-4c80-807e-76ceb117c7ef","type":"none","aud